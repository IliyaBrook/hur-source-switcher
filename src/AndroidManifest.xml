<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hur.sourceswitcher"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <application
        android:label="HUR Source Switcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="HUR Source Switcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".KeyReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="com.coagent.intent.action.KEY_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SourceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.coagent.intent.action.SOURCE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".UsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SourceService"
            android:exported="false" />

        <service
            android:name=".KeyMonitorService"
            android:exported="false" />

    </application>
</manifest>
